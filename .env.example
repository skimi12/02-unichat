# Configure a unique random secret of at least 32 bytes. No shared default exists.
SECRET_KEY=
# Optional; relative SQLite paths retain the original application-root location.
DATABASE_URL=sqlite:///data.db
# Keep unset in production. Only use 1 for local HTTP development on 127.0.0.1.
# UNICHAT_INSECURE_LOCAL_HTTP=1
# PostgreSQL aliases postgres:// and postgresql:// select the bundled psycopg 3.
# Explicit postgresql+psycopg:// is also supported. Keep actual credentials secret.
